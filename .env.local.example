# URL of the scholarmatch-server Spring Boot API (server-side only, never exposed to the browser)
API_BASE_URL=http://localhost:8080

# Canonical public origin of this web app, used for OG tags, robots.txt, and sitemap.xml.
# Set this to the real domain in production (e.g. https://scholarmatch.example).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
